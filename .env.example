PORT=3001
NODE_ENV=development

# ── Base de datos MySQL (credenciales compartidas para landlord + tenants) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=tu_password
DB_ADMIN_USER=root
DB_ADMIN_PASS=tu_password

# BD central del landlord (superadmin, tenants, planes)
DB_LANDLORD_NAME=turnoflow_landlord

# Nota: cada tenant tiene su propia BD con nombre turnoflow_t_{subdomain}
# Ej: turnoflow_t_barberia_juan — creada automáticamente al provisionar el tenant

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_cadena_aleatoria_segura_min32chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=otro_secreto_diferente_aleatorio_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Dominio de la plataforma ─────────────────────────────────────────────────
# Usado como fallback para detectar el subdominio del tenant desde el Host header
# Probeta: PLATFORM_DOMAIN=turnoflow.probeta.dev
# Producción: PLATFORM_DOMAIN=turnoflow.com
PLATFORM_DOMAIN=turnoflow.co

# ── Seed superadmin (solo se usa al correr seed:landlord) ─────────────────────
SA_USERNAME=superadmin
SA_EMAIL=superadmin@turnoflow.co
SA_PASSWORD=cambia_esta_password_segura

# ── CORS ─────────────────────────────────────────────────────────────────────
# Uno o varios orígenes separados por coma
# Ej: https://turnoflow.bitwia.com,https://admin.turnoflow.co
CORS_ORIGIN=https://turnoflow.bitwia.com

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=3145728

# ── Auditoría ─────────────────────────────────────────────────────────────────
AUDIT_RETENTION_DAYS=90

