PORT=3001
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=turnoflow
DB_USER=root
DB_PASS=tu_password

# JWT — Cambiar por valores aleatorios seguros en producción
JWT_SECRET=cambia_esto_por_cadena_aleatoria_segura_min32chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=otro_secreto_diferente_aleatorio_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Origen del frontend
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=3145728

# Retención de logs de auditoría (días)
AUDIT_RETENTION_DAYS=90
